---
# C-focused checks. The interesting ones for a VMM are bugprone-* (integer
# overflow in size math, narrowing), clang-analyzer-* (use-after-free, leaks,
# null deref) and cert-* (signal handlers, errno). cert-err33-c is off: it
# demands checking printf/snprintf results; bugprone-unused-return-value
# still covers the calls whose result matters.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  cert-*,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -cert-err33-c,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  concurrency-*,
  misc-*,
  -misc-include-cleaner,
  performance-*,
  portability-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-avoid-const-params-in-decls
WarningsAsErrors: ''
HeaderFilterRegex: '.*/(src|tests)/.*'
FormatStyle: file
...
