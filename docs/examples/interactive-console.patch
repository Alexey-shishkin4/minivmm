+static int notify(int fd)
+{
+    const uint64_t one = 1;
+    for (;;) {
+        const ssize_t n = write(fd, &one, sizeof(one));
+        if (n == (ssize_t)sizeof(one) || (n < 0 && errno == EAGAIN)) {
+            return 0;
+        }
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n >= 0) {
+            errno = EIO;
+        }
+        return -1;
+    }
