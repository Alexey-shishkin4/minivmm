+static int on_input(struct event_loop *loop, int fd, uint32_t events,
+                    void *opaque);
+
+static int flush_input(struct vmm_console *console)
+{
+    struct vmm *vm = console->vm;
+    int err = pthread_mutex_lock(&vm->serial_lock);
+    if (err != 0) {
+        errno = err;
+        return -1;
+    }
+    int ret = 0;
+    while (console->count != 0) {
+        const int accepted =
+            serial8250_receive(&vm->serial, console->input[console->head]);
+        if (accepted < 0) {
+            ret = -1;
+            break;
+        }
+        if (accepted == 0) {
+            break;
+        }
+        console->head = (console->head + 1U) % CONSOLE_INPUT_CAPACITY;
+        console->count--;
+    }
+    console->rx_waiting = console->count != 0;
+    const int saved = errno;
+    err = pthread_mutex_unlock(&vm->serial_lock);
+    if (ret < 0) {
+        errno = saved;
+        return -1;
+    }
+    if (err != 0) {
+        errno = err;
+        return -1;
+    }
+    if (console->input_paused && console->count < CONSOLE_INPUT_CAPACITY) {
+        if (event_loop_add(&console->loop, console->input_fd, EPOLLIN, on_input,
+                           console) < 0) {
+            return -1;
+        }
+        console->input_paused = false;
+    }
+    return 0;
+}
+
+static int on_space(struct event_loop *loop, int fd, uint32_t events,
+                    void *opaque)
+{
+    (void)loop;
+    (void)events;
+    for (;;) {
+        uint64_t value;
+        const ssize_t n = read(fd, &value, sizeof(value));
+        if (n == (ssize_t)sizeof(value)) {
+            continue;
+        }
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n < 0 && errno == EAGAIN) {
+            return flush_input(opaque);
+        }
+        if (n >= 0) {
+            errno = EIO;
+        }
+        return -1;
+    }
+}
+
+static int on_input(struct event_loop *loop, int fd, uint32_t events,
+                    void *opaque)
+{
+    struct vmm_console *console = opaque;
+    uint8_t bytes[256];
+
+    /* Bound work per callback, even if the producer never stops writing. */
+    for (unsigned batch = 0; batch < 16; batch++) {
+        size_t space = CONSOLE_INPUT_CAPACITY - console->count;
+        if (space == 0) {
+            if (event_loop_remove(loop, fd) < 0) {
+                return -1;
+            }
+            console->input_paused = true;
+            return 0;
+        }
+        if (space > sizeof(bytes)) {
+            space = sizeof(bytes);
+        }
+        const ssize_t n = read(fd, bytes, space);
+        if (n > 0) {
+            for (size_t i = 0; i < (size_t)n; i++) {
+                if (bytes[i] == 0x1d) { /* Ctrl-] exits the host VMM. */
+                    return request_stop(console);
+                }
+                const size_t tail =
+                    (console->head + console->count) % CONSOLE_INPUT_CAPACITY;
+                console->input[tail] = bytes[i];
+                console->count++;
+            }
+            if (flush_input(console) < 0) {
+                return -1;
+            }
+            continue;
+        }
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n == 0 || (n < 0 && errno == EIO)) {
+            return request_stop(console);
+        }
+        if (errno == EAGAIN) {
+            return (events & (EPOLLHUP | EPOLLERR)) != 0 ? request_stop(console)
+                                                         : 0;
+        }
+        return -1;
+    }
+    return 0;
+}
+
+static int on_signal(struct event_loop *loop, int fd, uint32_t events,
+                     void *opaque)
+{
+    (void)loop;
+    (void)events;
+    bool received = false;
+    for (;;) {
+        struct signalfd_siginfo info;
+        const ssize_t n = read(fd, &info, sizeof(info));
+        if (n == (ssize_t)sizeof(info)) {
+            received = true;
+            continue;
+        }
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n < 0 && errno == EAGAIN) {
+            return received ? request_stop(opaque) : 0;
+        }
+        if (n >= 0) {
+            errno = EIO;
+        }
+        return -1;
+    }
+}
+
+static void *run_vcpu(void *opaque)
+{
+    struct vmm_console *console = opaque;
+    sigset_t kick;
+    sigemptyset(&kick);
+    sigaddset(&kick, VCPU_KICK_SIGNAL);
+    worker_immediate_exit = &console->vcpu->run->immediate_exit;
+    const int err = pthread_sigmask(SIG_UNBLOCK, &kick, NULL);
+    if (err != 0) {
+        log_error("unblock vCPU kick signal: %s", strerror(err));
+        console->worker_stop = VCPU_STOP_ERROR;
+    } else {
+        console->worker_stop = vcpu_run(console->vcpu);
+    }
+    worker_immediate_exit = NULL;
+    if (event_loop_stop(&console->loop) < 0) {
+        log_errno("stop console event loop");
+    }
+    return NULL;
+}
+
+enum vcpu_stop vmm_run(struct vmm *vm, struct vcpu *vcpu, bool interactive)
+{
+    if (!interactive) {
+        return vcpu_run(vcpu);
+    }
+    if (!vm->has_irqchip || !isatty(STDIN_FILENO)) {
+        log_error("interactive Linux console requires a TTY on stdin");
+        return VCPU_STOP_ERROR;
+    }
+    struct vmm_console console = {
+        .vm = vm,
+        .vcpu = vcpu,
+        .input_fd = -1,
+        .space_fd = -1,
+        .signal_fd = -1,
+        .worker_stop = VCPU_STOP_ERROR,
+    };
+    struct termios original;
+    sigset_t signals;
+    sigset_t blocked;
+    sigset_t old_mask;
+    struct sigaction old_action;
+    struct sigaction action = {.sa_handler = kick_vcpu};
+    bool mask_saved = false;
+    bool action_saved = false;
+    bool raw_active = false;
+    bool loop_ready = false;
+    enum vcpu_stop result = VCPU_STOP_ERROR;
+    atomic_init(&console.stop_requested, false);
+
+    sigemptyset(&signals);
+    sigaddset(&signals, SIGINT);
+    sigaddset(&signals, SIGTERM);
+    blocked = signals;
+    sigaddset(&blocked, VCPU_KICK_SIGNAL);
+    int err = pthread_sigmask(SIG_BLOCK, &blocked, &old_mask);
+    if (err != 0) {
+        log_error("block console signals: %s", strerror(err));
+        return VCPU_STOP_ERROR;
+    }
+    mask_saved = true;
+    sigemptyset(&action.sa_mask);
+    if (sigaction(VCPU_KICK_SIGNAL, &action, &old_action) < 0) {
+        goto fail;
+    }
+    action_saved = true;
+    if (event_loop_init(&console.loop) < 0) {
+        goto fail;
+    }
+    loop_ready = true;
+    /* A separate open file description avoids making stdout nonblocking when
+     * stdin/stdout were both dup'ed from the same PTY slave. dup() is not enough. */
+    console.input_fd =
+        open("/proc/self/fd/0", O_RDONLY | O_NONBLOCK | O_NOCTTY | O_CLOEXEC);
+    console.space_fd = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);
+    console.signal_fd = signalfd(-1, &signals, SFD_NONBLOCK | SFD_CLOEXEC);
+    if (console.input_fd < 0 || console.space_fd < 0 || console.signal_fd < 0) {
+        goto fail;
+    }
+    if (event_loop_add(&console.loop, console.input_fd, EPOLLIN, on_input,
+                       &console) < 0 ||
+        event_loop_add(&console.loop, console.space_fd, EPOLLIN, on_space,
+                       &console) < 0 ||
+        event_loop_add(&console.loop, console.signal_fd, EPOLLIN, on_signal,
+                       &console) < 0 ||
+        tcgetattr(STDIN_FILENO, &original) < 0) {
+        goto fail;
+    }
+    struct termios raw = original;
+    cfmakeraw(&raw);
+    if (tcsetattr(STDIN_FILENO, TCSANOW, &raw) < 0) {
+        goto fail;
+    }
+    raw_active = true;
+    vm->console = &console;
+    err = pthread_create(&console.worker, NULL, run_vcpu, &console);
+    if (err != 0) {
+        errno = err;
+        goto fail;
+    }
+    console.worker_started = true;
+    const int loop_result = event_loop_run(&console.loop);
+    if (loop_result < 0) {
+        log_errno("console event loop");
+    }
+    const int stop_result = request_stop(&console);
+    if (stop_result < 0) {
+        log_errno("request vCPU stop");
+    }
+    err = pthread_join(console.worker, NULL);
+    if (err != 0) {
+        /* Releasing the stack/VM while the worker might still run is unsafe. */
+        if (raw_active) {
+            (void)tcsetattr(STDIN_FILENO, TCSANOW, &original);
+        }
+        die("join vCPU worker: %s", strerror(err));
+    }
+    console.worker_started = false;
+    if (loop_result == 0 && stop_result == 0) {
+        result = console.worker_stop;
+    }
+    goto out;
+
+fail:
+    log_errno("initialize interactive console");
+out:
+    vm->console = NULL;
+    if (raw_active && tcsetattr(STDIN_FILENO, TCSANOW, &original) < 0) {
+        log_errno("restore host terminal");
+        result = VCPU_STOP_ERROR;
+    }
+    if (loop_ready) {
+        event_loop_destroy(&console.loop);
+    }
+    if (console.input_fd >= 0) {
+        close(console.input_fd);
+    }
+    if (console.space_fd >= 0) {
+        close(console.space_fd);
+    }
+    if (console.signal_fd >= 0) {
+        close(console.signal_fd);
+    }
+    if (action_saved && sigaction(VCPU_KICK_SIGNAL, &old_action, NULL) < 0) {
+        log_errno("restore kick signal handler");
+        result = VCPU_STOP_ERROR;
+    }
+    if (mask_saved) {
+        err = pthread_sigmask(SIG_SETMASK, &old_mask, NULL);
+        if (err != 0) {
+            log_error("restore signal mask: %s", strerror(err));
+            result = VCPU_STOP_ERROR;
+        }
+    }
+    return result;
+}
