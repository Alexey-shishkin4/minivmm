+static int request_stop(struct vmm_console *console)
+{
+    atomic_store_explicit(&console->stop_requested, true, memory_order_release);
+    int err = 0;
+    if (console->worker_started) {
+        err = pthread_kill(console->worker, VCPU_KICK_SIGNAL);
+    }
+    const int ret = event_loop_stop(&console->loop);
+    if (err != 0 && err != ESRCH) {
+        errno = err;
+        return -1;
+    }
+    return ret;
