+"""Exercise a real guest shell through a PTY without pexpect."""
+
+import errno
+import fcntl
+import os
+import pty
+import select
+import signal
+import subprocess
+import termios
+import time
+
+import pytest
+
+pytestmark = [pytest.mark.kvm, pytest.mark.guest]
+
+
+class Console:
+    def __init__(self, process, master, stderr_path):
+        self.process = process
+        self.master = master
+        self.stderr_path = stderr_path
+        self.output = bytearray()
+        self.cursor = 0
+
+    def diagnostics(self):
+        serial = self.output[-32768:].decode(errors="replace")
+        stderr = self.stderr_path.read_text(errors="replace")[-32768:]
+        return f"serial:\n{serial}\nstderr:\n{stderr}"
+
+    def read_ready(self):
+        try:
+            data = os.read(self.master, 65536)
+        except BlockingIOError:
+            return
+        except OSError as error:
+            if error.errno == errno.EIO:
+                return
+            raise
+        self.output.extend(data)
+
+    def expect(self, needle, timeout=10):
+        deadline = time.monotonic() + timeout
+        while True:
+            found = self.output.find(needle, self.cursor)
+            if found >= 0:
+                self.cursor = found + len(needle)
+                return
+            left = deadline - time.monotonic()
+            assert left > 0, f"Timeout waiting for {needle!r}\n{self.diagnostics()}"
+            ready, _, _ = select.select([self.master], [], [], min(left, 0.1))
+            if ready:
+                self.read_ready()
+            if self.process.poll() is not None and not ready:
+                pytest.fail(f"VMM exited before {needle!r}\n{self.diagnostics()}")
+
+    def send(self, data, timeout=20):
+        deadline = time.monotonic() + timeout
+        offset = 0
+        while offset < len(data):
+            left = deadline - time.monotonic()
+            assert left > 0, f"Timeout sending input\n{self.diagnostics()}"
+            readable, writable, _ = select.select([self.master], [self.master], [], min(left, 0.1))
+            if readable:
+                self.read_ready()
+            if writable:
+                try:
+                    offset += os.write(self.master, data[offset : offset + 1024])
+                except BlockingIOError:
+                    continue
+
+    def wait_exit(self, timeout=10):
+        deadline = time.monotonic() + timeout
+        while self.process.poll() is None:
+            left = deadline - time.monotonic()
+            assert left > 0, f"VMM did not exit\n{self.diagnostics()}"
+            ready, _, _ = select.select([self.master], [], [], min(left, 0.1))
+            if ready:
+                self.read_ready()
+        return self.process.wait()
+
+
+@pytest.mark.parametrize("finish", ["guest_exit", "sigint", "sigterm", "escape"])
+def test_interactive_console(minivmm, guest_kernel, guest_initramfs, tmp_path, finish):
+    master, slave = pty.openpty()
+    original_termios = termios.tcgetattr(slave)
+    original_flags = fcntl.fcntl(slave, fcntl.F_GETFL)
+    os.set_blocking(master, False)
+    process = None
+    console = None
+    stderr_path = tmp_path / "vmm.stderr"
+
+    try:
+        with stderr_path.open("wb") as stderr:
+            process = subprocess.Popen(
+                [
+                    str(minivmm),
+                    "--kernel",
+                    str(guest_kernel),
+                    "--initrd",
+                    str(guest_initramfs),
+                    "--interactive",
+                ],
+                stdin=slave,
+                stdout=slave,
+                stderr=stderr,
+                start_new_session=True,
+            )
+            console = Console(process, master, stderr_path)
+            console.expect(b"minivmm# ", timeout=30)
+            assert process.poll() is None, console.diagnostics()
+            assert fcntl.fcntl(slave, fcntl.F_GETFL) == original_flags
+
+            # The expected marker does not occur literally in the echoed command.
+            console.send(b"printf 'PTY_%s\\n' OK\n")
+            console.expect(b"PTY_OK")
+            console.expect(b"minivmm# ")
+
+            if finish == "guest_exit":
+                # Foreground group exists before its child prints READY.
+                console.send(b"sh -c 'printf \"FG_%s\\n\" READY; exec sleep 30'\n")
+                console.expect(b"FG_READY")
+                console.send(b"\x03")  # Ctrl-C belongs to the guest foreground job.
+                console.expect(b"minivmm# ", timeout=5)
+                assert process.poll() is None, console.diagnostics()
+
+                # Exceeds the 4096-byte host queue and exercises RX backpressure.
+                commands = b"".join(f"printf 'PASTE_%03d\\n' {i}\n".encode() for i in range(200))
+                assert len(commands) > 4096
+                console.send(commands)
+                console.expect(b"PASTE_199", timeout=20)
+                for i in range(200):
+                    assert f"PASTE_{i:03d}".encode() in console.output
+                console.expect(b"minivmm# ")
+                console.send(b"exit\n")
+            elif finish in ("sigint", "sigterm"):
+                process.send_signal(signal.SIGINT if finish == "sigint" else signal.SIGTERM)
+            else:
+                console.send(b"\x1d")  # Ctrl-] exits the host VMM.
+
+            assert console.wait_exit() == 0, console.diagnostics()
+            assert termios.tcgetattr(slave) == original_termios
+            assert fcntl.fcntl(slave, fcntl.F_GETFL) == original_flags
+            assert "minivmm-init: FAIL" not in console.output.decode(errors="replace")
+            if finish == "guest_exit":
+                assert "guest requested reboot via i8042" in stderr_path.read_text()
+    finally:
+        if console is not None:
+            (tmp_path / "serial.log").write_bytes(console.output)
+        # Closing the PTY master also releases a writer blocked on console output.
+        os.close(master)
+        if process is not None and process.poll() is None:
+            process.terminate()
+            try:
+                process.wait(timeout=3)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait(timeout=3)
+        os.close(slave)
